# ============================================================================
# SISTEMA DE NOTIFICAÇÃO INDUSTRIAL - CONFIGURAÇÃO DE AMBIENTE
# ============================================================================

# Porta do servidor HTTP / WebSocket (Padrão: 3000)
PORT=3000

# Origem permitida para requisições CORS (Padrão: * ou especifique ex: http://localhost:3000)
CORS_ORIGIN=*

# Conexão com Banco de Dados MySQL
# Se não preenchido, o sistema utilizará o motor de banco de dados local integrado JSON
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_NAME=industrial_alerts
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_URL=

# Caminho da Sessão WhatsApp (Baileys)
WHATSAPP_SESSION_PATH=./auth_info_baileys

# Intervalo do Polling do Worker (em milissegundos) - Padrão: 2000ms
POLLING_INTERVAL=2000

# Número máximo de tentativas de reenvio em caso de erro
MAX_RETRY_ATTEMPTS=5

# Dias de retenção antes da limpeza automática de registros antigos (status 1 e 3)
DATA_RETENTION_DAYS=30

# Código de Acesso do Painel Industrial (Login Seguro)
# Em produção, utilize uma senha forte! Padrão dev: admin123
ACCESS_CODE=admin123

