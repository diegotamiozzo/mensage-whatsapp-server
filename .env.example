# ============================================================================
# SISTEMA DE NOTIFICAÇÃO SYSTEM - CONFIGURAÇÃO DE AMBIENTE
# ============================================================================

# Porta do servidor HTTP / WebSocket (Hardcoded 3000 no ambiente de deploy)
PORT=3000

# Conexão com Banco de Dados MySQL
# Se não preenchido, o sistema utilizará o motor de banco de dados local integrado de alta velocidade
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_NAME=industrial_alerts
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_URL=

# Caminho da Sessão WhatsApp (Baileys)
WHATSAPP_SESSION_PATH=./auth_info_baileys

# Intervalo do Polling do Worker (em milissegundos) - Padrão: 2000ms (2s)
POLLING_INTERVAL=5000

# Número máximo de tentativas de reenvio em caso de erro
MAX_RETRY_ATTEMPTS=5

# Dias de retenção antes da limpeza automática de registros antigos (status 1 e 3)
DATA_RETENTION_DAYS=30

# Código de Acesso do Painel Industrial (Login Seguro)
# Se não configurado, o padrão de demonstração aceito é "admin123"
ACCESS_CODE=admin123

# Hash de chave de sessão JWT/Token
JWT_SECRET=industrial-alert-secret-key-super-secure
